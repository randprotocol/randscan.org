{
  "name": "randscan-frontend",
  "version": "0.7.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "next lint && node scripts/i18n/untranslated.mjs",
