    "i18n:translate": "node scripts/i18n/translate.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "mmdb-lib": "^2.2.1",
    "next": "15.5.25",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "swr": "^2.2.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.12.12",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
